dwn_iso() {
    local iso_dir="$HOME/Downloads/ISO"
    mkdir -p "$iso_dir"

    # Arch Linux URLs
    local arch_url_base1="https://mirror.rackspace.com/archlinux/iso/latest/"
    local arch_url_base2="https://geo.mirror.pkgbuild.com/iso/latest/"

    # Tails
    local tails_url_base="https://mirrors.edge.kernel.org/tails/stable/"

    # ==================== ARCH LINUX ====================
    download_arch_iso() {
        local arch_latest_ver=$(curl -sL "${arch_url_base1}" | grep -oP 'archlinux-\K[0-9]{4}\.[0-9]{2}\.[0-9]{2}' | head -n 1)
        local iso_filename="archlinux-${arch_latest_ver}-x86_64.iso"

        if [ -f "$iso_dir/$iso_filename" ]; then
            echo "Arch ISO is already the latest version: $iso_filename"
            return 0
        fi

        echo "Downloading latest Arch Linux ISO: $iso_filename"

        if ! curl -L --progress-bar -o "$iso_dir/$iso_filename" "${arch_url_base1}${iso_filename}"; then
            echo "Primary mirror failed, trying fallback..."
            curl -L --progress-bar -o "$iso_dir/$iso_filename" "${arch_url_base2}${iso_filename}"
        fi

        curl -L -o "$iso_dir/sha256sums.txt" "${arch_url_base1}sha256sums.txt" || true
        curl -L -o "$iso_dir/b2sums.txt" "${arch_url_base1}b2sums.txt" || true
        curl -L -o "$iso_dir/${iso_filename}.sig" "${arch_url_base1}${iso_filename}.sig" || true

        if ! gpg --list-keys 76A5EF9054449A5C &>/dev/null; then
            gpg --auto-key-locate clear,wkd -v --locate-external-key pierre@archlinux.org
        fi

        sh "$iso_dir/iso_verifier.sh" "$iso_dir/$iso_filename"
    }

    # ==================== TAILS ====================
    download_tails_iso() {
        echo "Fetching latest Tails version..."

        local tails_latest_ver=$(curl -sL "${tails_url_base}" | \
            grep -oP 'tails-amd64-\K[0-9]+\.[0-9]+\.[0-9]+(?=/)' | sort -V | tail -n 1)

        if [ -z "$tails_latest_ver" ]; then
            tails_latest_ver=$(curl -sL "${tails_url_base}" | \
                grep -oP 'href="tails-amd64-\K[0-9.]+(?=/)' | sort -V | tail -n 1)
        fi

        if [ -z "$tails_latest_ver" ]; then
            echo "❌ Could not detect Tails version."
            return 1
        fi

        local iso_filename="tails-amd64-${tails_latest_ver}.iso"
        local version_dir="${tails_url_base}tails-amd64-${tails_latest_ver}/"

        echo "Latest Tails version detected: ${tails_latest_ver}"

        if [ -f "$iso_dir/$iso_filename" ]; then
            echo "Tails ISO is already the latest version: $iso_filename"
            return 0
        fi

        echo "Downloading Tails ISO: $iso_filename"

        curl -L --progress-bar -o "$iso_dir/$iso_filename" "${version_dir}${iso_filename}"
        curl -L --progress-bar -o "$iso_dir/$iso_filename.sig" "${version_dir}${iso_filename}.sig"

        # Tails signing key
        if ! gpg --list-keys DBB802B258ACD84F &>/dev/null 2>/dev/null; then
            echo "Downloading Tails signing key..."
            curl -L -o "$iso_dir/tails-signing.key" "https://tails.net/tails-signing.key"
            gpg --import "$iso_dir/tails-signing.key"
        fi

        sh "$iso_dir/iso_verifier.sh" "$iso_dir/$iso_filename"
    }

    echo "Checking for new Arch and Tails ISO versions..."
    download_arch_iso
    download_tails_iso
}

# Flash ISO to drive
flashiso() {
    if [[ $# -ne 2 ]]; then
        echo "Usage: flashiso <image.iso> <device>"
        echo "Example: flashiso archlinux.iso /dev/sdb"
        return 1
    fi

    local iso="$1"
    local dev="$2"

    [[ ! -f "$iso" ]] && echo "Error: ISO not found: $iso" && return 1
    [[ ! -b "$dev" ]] && echo "Error: Not a block device: $dev" && return 1

    echo "ISO: $iso"
    echo "Device: $dev"
    lsblk "$dev"
    echo "\nThis will DESTROY all data on $dev. Continue? [y/N]"
    read -r confirm
    [[ "$confirm" != "y" && "$confirm" != "Y" ]] && echo "Aborted." && return 1

    sudo dd if="$iso" of="$dev" bs=4M status=progress oflag=sync && sync
}

# FZF-based Anime Torrent Manager for .zshrc
#
# Source this from your .zshrc, e.g.:
#   source ~/.config/zsh/anime_manager.zsh
#
# CHANGES FROM ORIGINAL:
# - Fixed: "Continue browsing? n" now actually exits back to a clean shell
#   instead of falling through to the sub-menu it was called from. Return-code
#   convention: 0 = exit the tool entirely, non-zero = go back to main menu.
# - Fixed: "Continue browsing? y" no longer recursively calls anime() (which
#   was growing the call stack by one frame every loop) — it just lets the
#   existing while loop in anime() iterate again.
# - Fixed: awk ID extraction used gawk's 3-arg match(), which does not exist
#   in BSD awk (default on macOS) or mawk. Replaced with portable sub()/gsub().
# - Fixed: qBittorrent invocation now uses documented CLI flags
#   (--confirm-legal-notice --skip-dialog=true --save-path=...) confirmed
#   against `qbittorrent --help` on 5.2.2-1, and batches all selected
#   torrents into a single invocation instead of one process per torrent.
# - Added: recent-search picker (fzf) backed by a history file, so you don't
#   retype full titles.
# - Added: short-lived (60s) RSS response cache to avoid re-hitting nyaa.si
#   when re-running similar queries in the same session.
# - Deduplicated the quality/fansub fzf selection menus, previously copy
#   pasted four times, into two shared helpers.
# - Fixed: RSS setup interface didn't check for ESC/cancel on quality/fansub
#   selection like every other interface did; it would silently proceed with
#   blank filters.
# - Fixed: torrent selection processing loop now uses process substitution
#   instead of a trailing pipe, so results aren't lost to a subshell.
#
# NOTE ON qbittorrent-nox: the CLI flags below are verified against the GUI
# `qbittorrent` binary's --help output. qbittorrent-nox shares the same core
# argument parser in current releases, but if it doesn't pick up torrents on
# your system, run `qbittorrent-nox --help` and compare.

ANIME_DOWNLOAD_DIR="$HOME/Videos"
ANIME_CACHE_DIR="/tmp/anime_torrents"
ANIME_HISTORY_FILE="$HOME/.cache/anime_manager_history"
ANIME_RSS_CACHE_TTL=60  # seconds

# URL-encode a string for safe use in a query parameter. `${term// /+}` alone
# only handles spaces — anything with &, :, ', !, or non-ASCII characters
# (common in anime titles) needs real percent-encoding or it corrupts the
# query string (an unescaped & truncates it outright).
_url_encode() {
    local input="$1"
    if command -v python3 &> /dev/null; then
        python3 -c "import urllib.parse,sys; print(urllib.parse.quote_plus(sys.argv[1]))" "$input"
    elif command -v perl &> /dev/null; then
        perl -MURI::Escape -e 'my $s = uri_escape($ARGV[0]); $s =~ s/%20/+/g; print $s;' "$input"
    else
        # Crude fallback if neither is available: spaces only.
        echo "${input// /+}"
    fi
}

# HTTP request helper function. Sends a browser User-Agent instead of curl's
# default "curl/x.y.z" — nyaa.si sits behind Cloudflare, and a bare curl UA
# is a commonly-targeted bot signature, especially for repeated identical
# requests (exactly the "works once, fails on repeat" pattern seen here).
_ANIME_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

fetch_url() {
    local url="$1"
    if command -v curl &> /dev/null; then
        curl -sfL -A "$_ANIME_UA" "$url"
    elif command -v wget &> /dev/null; then
        wget -q -U "$_ANIME_UA" -O - "$url"
    else
        echo "Error: curl or wget is required but not installed."
        return 1
    fi
}

# Prune stale files from the cache dir so it doesn't grow forever. RSS cache
# entries past their TTL are dead weight (they get overwritten on next use of
# that exact query anyway, so keeping them serves no purpose); stray .torrent
# files are a safety net in case a prior session was killed before cleanup.
_anime_prune_cache() {
    [[ -d "$ANIME_CACHE_DIR" ]] || return 0
    find "$ANIME_CACHE_DIR" -name 'rss_*.xml' -mmin +$((ANIME_RSS_CACHE_TTL / 60 + 1)) -delete 2>/dev/null
    find "$ANIME_CACHE_DIR" -name '*.torrent' -mmin +60 -delete 2>/dev/null
}

# Fetch RSS with a short-lived local cache to avoid redundant network hits
_anime_fetch_rss_cached() {
    local url="$1"
    mkdir -p "$ANIME_CACHE_DIR"
    local hash=$(echo -n "$url" | cksum | awk '{print $1}')
    local cache_file="$ANIME_CACHE_DIR/rss_${hash}.xml"

    if [[ -f "$cache_file" ]]; then
        # date -r behaves identically on GNU and BSD, unlike `stat`, whose -f
        # flag means completely different things on each platform.
        local mtime=$(date -r "$cache_file" +%s 2>/dev/null)
        local now=$(date +%s)
        if [[ -n "$mtime" && $((now - mtime)) -lt $ANIME_RSS_CACHE_TTL ]]; then
            cat "$cache_file"
            return 0
        fi
    fi

    local body=$(fetch_url "$url")
    if echo "$body" | grep -q "<item>"; then
        # Only persist responses that actually contain entries — caching an
        # empty/failed fetch would make every retry of the same search term
        # replay that empty result for the rest of the TTL window.
        echo "$body" > "$cache_file"
    else
        rm -f "$cache_file"
    fi
    echo "$body"
}

# Function to calculate dynamic FZF height based on item count
_calculate_fzf_height() {
    local item_count="$1"
    local min_height=10
    local max_height=25
    local padding=4

    local calculated_height=$((item_count + padding))

    if [[ $calculated_height -lt $min_height ]]; then
        echo "${min_height}"
    elif [[ $calculated_height -gt $max_height ]]; then
        echo "${max_height}"
    else
        echo "${calculated_height}"
    fi
}

# Generic fzf single-select helper. Returns 1 (and prints nothing usable) if
# the user cancels (ESC / empty selection), 0 with the selection on stdout
# otherwise.
_anime_select_from_list() {
    local prompt="$1"
    local border_label="$2"
    local options="$3"

    local count=$(echo -e "$options" | wc -l)
    local height=$(_calculate_fzf_height $count)

    local sel=$(echo -e "$options" | fzf \
        --prompt="${prompt} › " \
        --height="${height}" \
        --border=rounded \
        --border-label=" ${border_label} " \
        --border-label-pos=2 \
        --cycle)

    [[ -z "$sel" ]] && return 1
    echo "$sel"
    return 0
}

# Quality picker. include_any=1 adds "Any Quality" (mapped to empty string).
_anime_select_quality() {
    local border_label="$1"
    local include_any="${2:-1}"
    local options="1080p\n720p\n480p"
    [[ "$include_any" == "1" ]] && options="${options}\nAny Quality"

    local sel
    sel=$(_anime_select_from_list "📺 Quality" "$border_label" "$options") || return 1
    [[ "$sel" == "Any Quality" ]] && sel=""
    echo "$sel"
}

# Fansub picker. include_all=1 adds "All Fansubs" (mapped to empty string).
# list="short" uses the reduced 3-entry list (used by RSS setup originally).
_anime_select_fansub() {
    local border_label="$1"
    local include_all="${2:-1}"
    local list="${3:-full}"
    local options

    if [[ "$list" == "short" ]]; then
        options="SubsPlease\nErai-raws\nDameDesuYo"
    else
        options="SubsPlease\nErai-raws\nDameDesuYo\nHorribleSubs\nCommie\nAniplex"
    fi
    [[ "$include_all" == "1" ]] && options="All Fansubs\n${options}"

    local sel
    sel=$(_anime_select_from_list "👥 Fansub" "$border_label" "$options") || return 1
    [[ "$sel" == "All Fansubs" ]] && sel=""
    echo "$sel"
}

# Search term entry with recent-history picker via fzf.
_anime_get_search_term() {
    mkdir -p "$(dirname "$ANIME_HISTORY_FILE")"
    touch "$ANIME_HISTORY_FILE"

    local history
    if command -v tac &> /dev/null; then
        history=$(tac "$ANIME_HISTORY_FILE" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | awk '!seen[$0]++')
    else
        history=$(tail -r "$ANIME_HISTORY_FILE" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | awk '!seen[$0]++')
    fi

    local fzf_output
    fzf_output=$(echo "$history" | fzf \
        --prompt="🔍 Search (pick recent or type new) › " \
        --print-query \
        --height=15 \
        --border=rounded \
        --border-label=" Recent Searches " \
        --border-label-pos=2 \
        --cycle)
    local fzf_status=$?

    # fzf exit codes: 0 = normal accept (item selected), 1 = no match (typed
    # query accepted via Enter anyway — this is the whole point of
    # --print-query, and happens on every brand-new search term), 130 =
    # interrupted (ESC/Ctrl-C). Only 130 means "actually cancelled."
    if [[ $fzf_status -eq 130 ]]; then
        return 1
    fi

    local result
    result=$(echo "$fzf_output" | tail -1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

    if [[ -n "$result" ]]; then
        if [[ "$(tail -1 "$ANIME_HISTORY_FILE" 2>/dev/null)" != "$result" ]]; then
            echo "$result" >> "$ANIME_HISTORY_FILE"
        fi
    fi
    echo "$result"
}

# Main FZF anime interface
anime() {
    if ! command -v fzf &> /dev/null; then
        echo "Error: fzf is required but not installed."
        echo "Install it with: brew install fzf (macOS) or apt install fzf (Ubuntu)"
        return 1
    fi

    _anime_prune_cache

    while true; do
        local options="🔍 Search Anime\n📺 Latest Releases\n🌸 Seasonal Anime\n⚙️ Browse by Fansub\n🔄 Setup RSS\n❌ Exit"
        local option_count=$(echo -e "$options" | wc -l)
        local height=$(_calculate_fzf_height $option_count)

        local choice=$(echo -e "$options" | fzf \
            --prompt="🎌 Anime Manager › " \
            --height="${height}" \
            --border=rounded \
            --border-label=" Main Menu " \
            --border-label-pos=2 \
            --ansi \
            --cycle \
            --info=inline)

        case "$choice" in
            *"Search Anime"*)
                _anime_search_interface
                [[ $? -eq 0 ]] && break
                ;;
            *"Latest Releases"*)
                _anime_latest_interface
                [[ $? -eq 0 ]] && break
                ;;
            *"Seasonal Anime"*)
                _anime_seasonal_interface
                [[ $? -eq 0 ]] && break
                ;;
            *"Browse by Fansub"*)
                _anime_fansub_interface
                [[ $? -eq 0 ]] && break
                ;;
            *"Setup RSS"*)
                _anime_rss_interface
                ;;
            *"Exit"*|"")
                break
                ;;
        esac
    done

    clear
}

